# Template for local testing. Copy to ".env" next to this file and fill in the values.
# Only FRITZ_* keys are read from this file; watchdog settings (DRY_RUN, PROBES, ...) are
# environment variables (see README.md). In a container, set everything in compose.yaml instead.

FRITZ_HOST=fritz.box
FRITZ_USER=
FRITZ_PASSWORD=
FRITZ_TLS=1
